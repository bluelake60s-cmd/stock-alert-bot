# Copy this file to .env for local testing. .env is gitignored.
# In GitHub Actions, set these as repo Secrets (Settings → Secrets and variables → Actions).

# --- Telegram (required) ---
# 1. Open Telegram, talk to @BotFather → /newbot → copy the token here.
# 2. Send any message to your new bot, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- Finnhub (required for CEO-mention + analyst-upgrade signals) ---
# Free key at https://finnhub.io
FINNHUB_API_KEY=your-finnhub-key

# --- Optional: LLM filter to cut false positives. Bot is fully free without it. ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional knobs ---
# DRY_RUN=true                 # print alerts instead of sending; does not advance state
# ARK_FUNDS=ARKK,ARKQ,ARKW,ARKG,ARKF
